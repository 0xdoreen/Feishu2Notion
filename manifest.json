{
  "manifest_version": 3,
  "name": "飞书文档 → Notion 一键保存",
  "version": "0.1.0",
  "description": "打开飞书文档时一键把正文、图片和附件保存到 Notion database",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.feishu.cn/*",
    "https://api.notion.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/docx/*",
        "https://*.feishu.cn/docs/*",
        "https://*.feishu.cn/wiki/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
